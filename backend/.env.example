# Runtime
# EXE 기본값(0-04): PAPER + KIS 모의 자동매매 ON, 실거래/AI실행/선물 모두 OFF.
# 이 템플릿을 .env 로 복사하고 KIS 모의투자 자격(KIS_APP_KEY/SECRET/ACCOUNT_NO)
# 만 채우면 PAPER / KIS 모의 자동매매가 안전하게 시작됩니다. 실거래 0원.
APP_ENV=local
APP_NAME=auto-trader-backend
# DEFAULT_MODE: SIMULATION(가짜데이터+MockBroker) / PAPER(실시세+KIS 모의).
# EXE 기본은 PAPER. LIVE_* 모드는 별도 옵트인(절대 기본값 금지).
DEFAULT_MODE=PAPER
# 아래 3개는 *절대* true 로 두지 않습니다 (실거래/AI자동실행/선물 차단).
ENABLE_LIVE_TRADING=false
ENABLE_AI_EXECUTION=false
ENABLE_FUTURES_LIVE_TRADING=false
# 작업 10 — 위험 기능 다중 잠금 (app.core.feature_flags). 기본 false 유지.
# crypto_futures_live 는 APP_ENV=local 에서 *영구* hard-block (단일 flag
# 만으로 절대 활성화 불가). kimp_strategy 는 전략 모듈 활성 여부일 뿐 실거래
# 허용 여부가 아니며, paper/mock 에서도 전략 테스트 가능.
ENABLE_CRYPTO_FUTURES_LIVE=false
ENABLE_KIMP_STRATEGY=false

# AI Paper background tick — Paper 모의 판단 반복 실행용이며 *실거래 주문
# 권한이 아닙니다*. EXE 기본 ON. RUNNING + 장중(09:00~15:30 KST) + PAPER/SIM
# 모드 + ENABLE_LIVE_TRADING=false 일 때만 N초마다 run-once 진단 파이프라인을
# 자동 실행합니다. broker / OrderExecutor / route_order 호출 0건.
ENABLE_AI_PAPER_BACKGROUND_TICK=true
AI_PAPER_TICK_INTERVAL_SECONDS=30
AI_PAPER_TICK_MAX_PER_DAY=0
# EXE 기본 false — dry_run 이 아니므로 가상 주문 생성까지 진행(실거래 아님).
AI_PAPER_TICK_DRY_RUN=false
# Paper 모의 체결 시뮬레이션 — *실거래가 아닙니다*. broker 호출 0건.
# EXE 기본 true 로 완전한 모의매매(가상 주문 생성+체결+포트폴리오 반영) 활성화.
# 조합: ENABLE_AI_PAPER_BACKGROUND_TICK=true / AI_PAPER_TICK_DRY_RUN=false /
#       AI_PAPER_ALLOW_SIMULATED_FILLS=true / ENABLE_LIVE_TRADING=false / KIS_IS_PAPER=true
AI_PAPER_ALLOW_SIMULATED_FILLS=true
AI_PAPER_FILL_SLIPPAGE_BPS=0.0

# PAPER_BROKER_KIND: MOCK(내부 가짜) / KIS_PAPER(한투 모의투자 API). 빈 값이면
# default_mode + KIS_IS_PAPER 로 자동 추론. EXE 기본은 KIS_PAPER.
PAPER_BROKER_KIND=KIS_PAPER

# KIS Paper Auto Trading은 한투 모의투자 API 전용이며 *실거래 권한이 아닙니다*.
# 모의 계좌로 주문이 나가며 실제 돈은 0원입니다. KIS_IS_PAPER=true 와
# ENABLE_LIVE_TRADING=false 가 반드시 필요합니다. EXE 기본 ON.
# dry_run=true 이면 KIS API 호출 없이 검증만(KIS_PAPER_DRY_RUN_OK).
# KIS 자격(KIS_APP_KEY/SECRET/ACCOUNT_NO) 미설정 시 readiness 가 BLOCKED 처리
# → 자동으로 주문이 나가지 않습니다 (안전).
ENABLE_KIS_PAPER_AUTO_TRADING=true
# EXE 기본 false — KIS 모의 API 로 실제 모의주문 제출(KIS_PAPER_SUBMITTED).
KIS_PAPER_AUTO_ORDER_DRY_RUN=false
KIS_PAPER_AUTO_MAX_ORDERS_PER_DAY=10
KIS_PAPER_AUTO_MAX_ORDER_NOTIONAL=1000000
KIS_PAPER_AUTO_ORDER_WINDOW_START=09:05
KIS_PAPER_AUTO_ORDER_WINDOW_END=14:50
KIS_PAPER_AUTO_MIN_CONFIDENCE=0.6
KIS_PAPER_AUTO_MIN_QUALITY_SCORE=60
# 체결 폴링 — KIS 모의주문 체결상태를 주기적으로 갱신. EXE 기본 ON.
KIS_PAPER_FILL_POLLING=true
KIS_PAPER_FILL_POLL_INTERVAL_SECONDS=10

# Server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Broker secrets - never put real values in git
# 실제 값은 backend/.env 에만 입력하세요. 본 .env.example 에는 비워 둡니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# KIS_PRODUCT_CODE: 계좌상품코드 (국내주식 현금 기본 "01"). secret 아님.
KIS_PRODUCT_CODE=01
KIS_IS_PAPER=true
KIS_RATE_LIMIT_CALLS=5
KIS_RATE_LIMIT_WINDOW_SECONDS=1.0

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# AI provider secrets - backend only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_TIMEOUT_SECONDS=30.0

# Database - SQLite by default for local dev; switch to PostgreSQL in prod
DATABASE_URL=sqlite:///./data/auto_trader.db
REDIS_URL=redis://localhost:6379/0

# Market data provider - "mock" (deterministic synthetic) or "yfinance" (Yahoo Finance)
MARKET_DATA_PROVIDER=mock

# Background poller that updates OrderAuditLog with broker fill status
ENABLE_FILL_POLLING=false
FILL_POLLING_INTERVAL_SECONDS=5

# RiskPolicy thresholds — operator-tunable without code changes.
# Defaults match RiskPolicy() defaults; lower these to tighten risk in production.
RISK_MAX_ORDER_NOTIONAL=1000000
RISK_MAX_DAILY_LOSS=200000
RISK_MAX_POSITIONS=5
RISK_MAX_SYMBOL_EXPOSURE=1500000

# #64: Notifications (Telegram 1차 채널).
# 토큰은 backend/.env에만 — 절대 git/docs/frontend에 노출하지 말 것.
# 비워두면 NoOpChannel로 안전하게 동작 (알림 발송 0건).
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_MIN_SEVERITY=INFO
NOTIFICATIONS_DEDUPE_WINDOW_SECONDS=60
NOTIFICATIONS_ALWAYS_SEND_CRITICAL=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5.0
TELEGRAM_MAX_RETRIES=1
